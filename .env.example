# docker compose 环境变量示例（复制为 .env 后按需修改；.env 本身不入库）

# ---- voice-bridge 基础镜像（本机已有 flashhead-base:cu128，含 torch 2.10+cu128）----
VOICE_BRIDGE_BASE_IMAGE=flashhead-base:cu128

# ---- DSH harness 源码树（dsh-web 镜像的构建上下文）----
DSH_HARNESS_DIR=D:/kaiyuan/deepseek-harness

# ---- 宿主运行时数据路径（按实际位置覆盖）----
VOICES_DIR_HOST=D:/speech-to-speech/voices
MODELS_DIR_HOST=D:/speech-to-speech/models
DUIX_DATA_DIR=D:/duix_avatar_data

# ---- NapCat（--profile qq 时使用）----
NAPCAT_QQ=
NAPCAT_TOKEN=
NAPCAT_DATA_DIR=D:/napcat/data
