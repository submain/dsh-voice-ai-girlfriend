{
  "_说明": "Docker 部署专用配置模板（配合仓库根 docker-compose.yml）。与 bridge-config.example.json 的差异只在路径与 DUIX 地址：容器内挂载点见 compose volumes。使用：复制为 bridge/bridge-config.json 后按需修改。",

  "host": "0.0.0.0",
  "port": 8765,
  "cors_origins": [
    "http://127.0.0.1:3080",
    "http://localhost:3080"
  ],
  "stt": {
    "backend": "funasr",
    "model_name": "models/funasr/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch",
    "device": "cuda",
    "torch_dtype": "float16",
    "compile_mode": null,
    "language": "zh",
    "gen_kwargs": {
      "max_new_tokens": 128,
      "num_beams": 2,
      "return_timestamps": false,
      "task": "transcribe"
    }
  },
  "tts": {
    "model_name": "/app/models/Qwen3-TTS-12Hz-1.7B-Base",
    "device": "cuda",
    "dtype": "auto",
    "attn_implementation": "eager",
    "ref_audio": "ref_audio.wav",
    "ref_text": "你的参考音频对应的文字（录音时照着读的台词）",
    "language": "zh",
    "speaker": null,
    "xvec_only": false,
    "parity_mode": false,
    "non_streaming_mode": true,
    "max_new_tokens": 1536,
    "blocksize": 512
  },
  "media": {
    "bg_images_dir": "assets/bg-images",
    "task_videos_dir": "assets/task-videos"
  },
  "deepseek": {
    "api_key": "可选：DeepSeek API key（余额 badge 用）。LLM 已切 Qwen 后可留空"
  },
  "qq": {
    "enabled": false,
    "napcat_base": "http://napcat:3000",
    "napcat_token": "你的NapCat OneBot token",
    "target_qq": 0
  },
  "digital_human": {
    "enabled": true,
    "duix_base": "http://duix-avatar-gen-video:8383",
    "data_dir": "/duix_data/face2face",
    "temp_dir": "temp",
    "avatar_video": "my_avatar.mp4",
    "max_keep": 200,
    "workdir_keep_hours": 2,
    "warmup_rounds": 2,
    "segment_mode": "punct",
    "segment_chars": 100,
    "segment_min_chars": 75,
    "first_segment_chars": 24,
    "first_segment_min_chars": 10,
    "submit_retry_sec": 5,
    "query_interval_sec": 2,
    "query_timeout_sec": 240,
    "submit_conn_fails": 6,
    "container_name": "duix-avatar-gen-video",
    "docker_cli": "docker",
    "stop_container_on_disable": true
  },
  "cosyvoice": {
    "base": "http://192.168.2.218:8300",
    "voice_id": "default",
    "timeout_sec": 60
  },
  "persona": {
    "default_voice": "<voices 下的音色文件夹名>",
    "default_avatar": "my_avatar.mp4",
    "default_idle": "default",
    "voices_dir": "/app/voices"
  }
}
